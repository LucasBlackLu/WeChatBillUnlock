<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.oplus.gleanerservice" />
        <package android:name="org.lsposed.manager" />
        <package android:name="com.oplus.aimemory" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WxBill"
        android:forceQueryable="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|uiMode"
            android:label="@string/app_name" />

        <!-- 桌面入口单独做成 alias，方便在应用内隐藏 / 恢复图标 -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- LSPosed 模块声明（新版 API 101 走 META-INF/xposed/*，这两条留给管理器展示） -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="让小布记忆「自动记账 → 支持的应用」出现微信：在配置读取处补一条微信记录，并在规则无效时补全 ext。不写数据库。" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>
</manifest>
